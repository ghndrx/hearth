package handlers

import (
	"context"
	"encoding/json"
	"errors"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gofiber/fiber/v2"
	"github.com/google/uuid"
	"github.com/stretchr/testify/assert"

	"hearth/internal/models"
)

type mockInteractionService struct {
	handleInteractionFunc func(ctx context.Context, interaction *models.Interaction) (*models.InteractionResponse, error)
	createResponseFunc    func(ctx context.Context, token string, resp *models.InteractionResponse) error
	editResponseFunc      func(ctx context.Context, token string, resp *models.InteractionResponse) error
	deleteResponseFunc    func(ctx context.Context, token, messageID string) error
}

func (m *mockInteractionService) HandleInteraction(ctx context.Context, interaction *models.Interaction) (*models.InteractionResponse, error) {
	return m.handleInteractionFunc(ctx, interaction)
}

func (m *mockInteractionService) CreateResponse(ctx context.Context, token string, resp *models.InteractionResponse) error {
	return m.createResponseFunc(ctx, token, resp)
}

func (m *mockInteractionService) EditResponse(ctx context.Context, token string, resp *models.InteractionResponse) error {
	return m.editResponseFunc(ctx, token, resp)
}

func (m *mockInteractionService) DeleteResponse(ctx context.Context, token, messageID string) error {
	return m.deleteResponseFunc(ctx, token, messageID)
}

func setupInteractionApp() *fiber.App {
	app := fiber.New()
	app.Use(func(c *fiber.Ctx) error {
		userID := c.Get("X-Test-User-ID")
		if userID != "" {
			c.Locals("userID", userID)
		}
		return c.Next()
	})
	return app
}

func TestHandleInteraction_Success(t *testing.T) {
	app := setupInteractionApp()
	t.Cleanup(func() { _ = app.Shutdown() })

	mock := &mockInteractionService{
		handleInteractionFunc: func(ctx context.Context, interaction *models.Interaction) (*models.InteractionResponse, error) {
			return &models.InteractionResponse{
				Type: 4,
				Data: map[string]interface{}{"content": "pong"},
			}, nil
		},
	}

	app.Post("/interactions", func(c *fiber.Ctx) error {
		var body struct {
			ID        uuid.UUID   `json:"id"`
			Type      int         `json:"type"`
			Data      interface{} `json:"data"`
			UserID    string      `json:"user_id"`
			ServerID  *string     `json:"server_id"`
			ChannelID string      `json:"channel_id"`
			Token     string      `json:"token"`
			AppID     string      `json:"app_id"`
		}
		if err := c.BodyParser(&body); err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "invalid body"})
		}

		if body.ID == uuid.Nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "missing interaction ID"})
		}

		interaction := &models.Interaction{
			ID:        body.ID,
			Type:      body.Type,
			Data:      body.Data,
			UserID:    body.UserID,
			ServerID:  body.ServerID,
			ChannelID: body.ChannelID,
			Token:     body.Token,
			AppID:     body.AppID,
		}

		resp, err := mock.HandleInteraction(c.Context(), interaction)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": "internal error"})
		}

		return c.JSON(resp)
	})

	interactionID := uuid.New()
	reqBody := `{"id":"` + interactionID.String() + `","type":1,"token":"test-token","app_id":"app1","channel_id":"ch1","user_id":"user1"}`
	req := httptest.NewRequest(http.MethodPost, "/interactions", strings.NewReader(reqBody))
	req.Header.Set("Content-Type", "application/json")

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, fiber.StatusOK, resp.StatusCode)

	var result map[string]interface{}
	json.NewDecoder(resp.Body).Decode(&result)
	assert.Equal(t, float64(4), result["type"])
}

func TestHandleInteraction_InvalidBody(t *testing.T) {
	app := setupInteractionApp()
	t.Cleanup(func() { _ = app.Shutdown() })

	app.Post("/interactions", func(c *fiber.Ctx) error {
		var body struct {
			ID   uuid.UUID `json:"id"`
			Type int       `json:"type"`
		}
		if err := c.BodyParser(&body); err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "invalid body"})
		}
		return nil
	})

	req := httptest.NewRequest(http.MethodPost, "/interactions", strings.NewReader("not json"))
	req.Header.Set("Content-Type", "application/json")

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, fiber.StatusBadRequest, resp.StatusCode)
}

