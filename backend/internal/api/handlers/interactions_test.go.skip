func TestEditInteractionResponse_Success(t *testing.T) {
	app := setupInteractionApp()
	t.Cleanup(func() { _ = app.Shutdown() })

	mock := &mockInteractionService{
		editResponseFunc: func(ctx context.Context, token string, resp *models.InteractionResponse) error {
			return nil
		},
	}

	app.Patch("/interactions/:token/messages/:messageId", func(c *fiber.Ctx) error {
		token := c.Params("token")
		messageID := c.Params("messageId")

		var body models.InteractionResponse
		if err := c.BodyParser(&body); err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "invalid body"})
		}

		if err := mock.EditResponse(c.Context(), token, &body); err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": "internal error"})
		}

		return c.JSON(fiber.Map{
			"message_id": messageID,
			"updated":    true,
		})
	})

	reqBody := `{"type":4,"data":{"content":"edited response"}}`
	req := httptest.NewRequest(http.MethodPatch, "/interactions/test-token/messages/msg-123", strings.NewReader(reqBody))
	req.Header.Set("Content-Type", "application/json")

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, fiber.StatusOK, resp.StatusCode)

	var result map[string]interface{}
	json.NewDecoder(resp.Body).Decode(&result)
	assert.Equal(t, "msg-123", result["message_id"])
	assert.Equal(t, true, result["updated"])
}

func TestDeleteInteractionResponse_Success(t *testing.T) {
	app := setupInteractionApp()
	t.Cleanup(func() { _ = app.Shutdown() })

	mock := &mockInteractionService{
		deleteResponseFunc: func(ctx context.Context, token, messageID string) error {
			return nil
		},
	}

	app.Delete("/interactions/:token/messages/:messageId", func(c *fiber.Ctx) error {
		token := c.Params("token")
		messageID := c.Params("messageId")

		if err := mock.DeleteResponse(c.Context(), token, messageID); err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": "internal error"})
		}

		return c.SendStatus(fiber.StatusNoContent)
	})

	req := httptest.NewRequest(http.MethodDelete, "/interactions/test-token/messages/msg-456", nil)

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, fiber.StatusNoContent, resp.StatusCode)
}
