package handlers

import (
	"context"
	"encoding/json"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gofiber/fiber/v2"
	"github.com/google/uuid"
	"github.com/stretchr/testify/assert"

	"hearth/internal/models"
)

type mockAudioSettingsService struct {
	getSettingsFunc    func(ctx context.Context, userID, serverID uuid.UUID) (*models.ServerAudioSettings, error)
	getAllForUserFunc   func(ctx context.Context, userID uuid.UUID) ([]*models.ServerAudioSettings, error)
	updateSettingsFunc func(ctx context.Context, userID, serverID uuid.UUID, updates *models.UpdateServerAudioSettingsRequest) (*models.ServerAudioSettings, error)
	deleteSettingsFunc func(ctx context.Context, userID, serverID uuid.UUID) error
}

func (m *mockAudioSettingsService) GetSettings(ctx context.Context, userID, serverID uuid.UUID) (*models.ServerAudioSettings, error) {
	if m.getSettingsFunc != nil {
		return m.getSettingsFunc(ctx, userID, serverID)
	}
	return nil, nil
}

func (m *mockAudioSettingsService) GetAllForUser(ctx context.Context, userID uuid.UUID) ([]*models.ServerAudioSettings, error) {
	if m.getAllForUserFunc != nil {
		return m.getAllForUserFunc(ctx, userID)
	}
	return nil, nil
}

func (m *mockAudioSettingsService) UpdateSettings(ctx context.Context, userID, serverID uuid.UUID, updates *models.UpdateServerAudioSettingsRequest) (*models.ServerAudioSettings, error) {
	if m.updateSettingsFunc != nil {
		return m.updateSettingsFunc(ctx, userID, serverID, updates)
	}
	return nil, nil
}

func (m *mockAudioSettingsService) DeleteSettings(ctx context.Context, userID, serverID uuid.UUID) error {
	if m.deleteSettingsFunc != nil {
		return m.deleteSettingsFunc(ctx, userID, serverID)
	}
	return nil
}

func setupAudioSettingsTestApp(mock *mockAudioSettingsService) *fiber.App {
	app := fiber.New()

	app.Use(func(c *fiber.Ctx) error {
		userIDStr := c.Get("X-Test-User-ID")
		if userIDStr != "" {
			userID, err := uuid.Parse(userIDStr)
			if err == nil {
				c.Locals("userID", userID)
			}
		}
		return c.Next()
	})

	handler := NewServerAudioSettingsHandler(mock)

	app.Get("/servers/:id/audio-settings", handler.GetSettings)
	app.Get("/audio-settings", handler.GetAllSettings)
	app.Post("/servers/:id/audio-settings", handler.UpdateSettings)
	app.Delete("/servers/:id/audio-settings", handler.DeleteSettings)

	return app
}

func TestAudioGetSettings_Success(t *testing.T) {
	userID := uuid.New()
	serverID := uuid.New()

	mock := &mockAudioSettingsService{
		getSettingsFunc: func(ctx context.Context, uID, sID uuid.UUID) (*models.ServerAudioSettings, error) {
			return &models.ServerAudioSettings{
				ID:           uuid.New(),
				UserID:       uID,
				ServerID:     sID,
				InputVolume:  80,
				OutputVolume: 60,
				Muted:        false,
				Deafened:     false,
			}, nil
		},
	}

	app := setupAudioSettingsTestApp(mock)
	t.Cleanup(func() { _ = app.Shutdown() })

	req := httptest.NewRequest("GET", "/servers/"+serverID.String()+"/audio-settings", nil)
	req.Header.Set("X-Test-User-ID", userID.String())

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, 200, resp.StatusCode)

	var result models.ServerAudioSettings
	err = json.NewDecoder(resp.Body).Decode(&result)
	assert.NoError(t, err)
	assert.Equal(t, 80, result.InputVolume)
	assert.Equal(t, 60, result.OutputVolume)
}

func TestAudioGetSettings_InvalidServerID(t *testing.T) {
	userID := uuid.New()

	mock := &mockAudioSettingsService{}

	app := setupAudioSettingsTestApp(mock)
	t.Cleanup(func() { _ = app.Shutdown() })

	req := httptest.NewRequest("GET", "/servers/not-a-uuid/audio-settings", nil)
	req.Header.Set("X-Test-User-ID", userID.String())

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, 400, resp.StatusCode)
}

func TestAudioGetAllSettings_Success(t *testing.T) {
	userID := uuid.New()

	mock := &mockAudioSettingsService{
		getAllForUserFunc: func(ctx context.Context, uID uuid.UUID) ([]*models.ServerAudioSettings, error) {
			return []*models.ServerAudioSettings{
				{
					ID:           uuid.New(),
					UserID:       uID,
					ServerID:     uuid.New(),
					InputVolume:  50,
					OutputVolume: 75,
				},
				{
					ID:           uuid.New(),
					UserID:       uID,
					ServerID:     uuid.New(),
					InputVolume:  100,
					OutputVolume: 100,
				},
			}, nil
		},
	}

	app := setupAudioSettingsTestApp(mock)
	t.Cleanup(func() { _ = app.Shutdown() })

	req := httptest.NewRequest("GET", "/audio-settings", nil)
	req.Header.Set("X-Test-User-ID", userID.String())

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, 200, resp.StatusCode)

	var result []*models.ServerAudioSettings
	err = json.NewDecoder(resp.Body).Decode(&result)
	assert.NoError(t, err)
	assert.Len(t, result, 2)
}

func TestAudioUpdateSettings_Success(t *testing.T) {
	userID := uuid.New()
	serverID := uuid.New()

	mock := &mockAudioSettingsService{
		updateSettingsFunc: func(ctx context.Context, uID, sID uuid.UUID, updates *models.UpdateServerAudioSettingsRequest) (*models.ServerAudioSettings, error) {
			return &models.ServerAudioSettings{
				ID:           uuid.New(),
				UserID:       uID,
				ServerID:     sID,
				InputVolume:  75,
				OutputVolume: 90,
				Muted:        true,
				Deafened:     false,
			}, nil
		},
	}

	app := setupAudioSettingsTestApp(mock)
	t.Cleanup(func() { _ = app.Shutdown() })

	body := `{"input_volume":75,"output_volume":90,"muted":true}`
	req := httptest.NewRequest("POST", "/servers/"+serverID.String()+"/audio-settings", strings.NewReader(body))
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("X-Test-User-ID", userID.String())

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, 200, resp.StatusCode)

	var result models.ServerAudioSettings
	err = json.NewDecoder(resp.Body).Decode(&result)
	assert.NoError(t, err)
	assert.Equal(t, 75, result.InputVolume)
	assert.Equal(t, 90, result.OutputVolume)
	assert.True(t, result.Muted)
}

