func TestAudioDeleteSettings_Success(t *testing.T) {
	userID := uuid.New()
	serverID := uuid.New()

	mock := &mockAudioSettingsService{
		deleteSettingsFunc: func(ctx context.Context, uID, sID uuid.UUID) error {
			return nil
		},
	}

	app := setupAudioSettingsTestApp(mock)
	t.Cleanup(func() { _ = app.Shutdown() })

	req := httptest.NewRequest("DELETE", "/servers/"+serverID.String()+"/audio-settings", nil)
	req.Header.Set("X-Test-User-ID", userID.String())

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, 200, resp.StatusCode)

	var result map[string]interface{}
	err = json.NewDecoder(resp.Body).Decode(&result)
	assert.NoError(t, err)
	assert.Equal(t, true, result["success"])
}

