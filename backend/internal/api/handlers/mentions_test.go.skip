func TestGetStats_Success(t *testing.T) {
	userID := uuid.New()

	mock := &mockMentionService{
		getStatsFunc: func(ctx context.Context, uid uuid.UUID) (*models.MentionStats, error) {
			return &models.MentionStats{
				TotalCount:  10,
				UnreadCount: 3,
				TodayCount:  2,
			}, nil
