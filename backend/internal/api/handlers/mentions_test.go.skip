package handlers

import (
	"context"
	"encoding/json"
	"net/http/httptest"
	"testing"
	"time"

	"github.com/gofiber/fiber/v2"
	"github.com/google/uuid"
	"github.com/stretchr/testify/assert"

	"hearth/internal/models"
	"hearth/internal/services"
)

type mockMentionService struct {
	getMentionsFunc               func(ctx context.Context, filter *models.MentionFilter) ([]*models.Mention, int, error)
	getUnreadCountFunc            func(ctx context.Context, userID uuid.UUID) (int, error)
	getStatsFunc                  func(ctx context.Context, userID uuid.UUID) (*models.MentionStats, error)
	markAsReadFunc                func(ctx context.Context, mentionID, userID uuid.UUID) error
	markAllAsReadFunc             func(ctx context.Context, userID uuid.UUID) (int, error)
	markChannelMentionsAsReadFunc func(ctx context.Context, userID, channelID uuid.UUID) (int, error)
	searchFunc                    func(ctx context.Context, userID uuid.UUID, query string, limit int) ([]*models.Mention, error)
}

func setupMentionsTestApp(mock *mockMentionService) *fiber.App {
	app := fiber.New()

	app.Use(func(c *fiber.Ctx) error {
		userIDStr := c.Get("X-Test-User-ID")
		if userIDStr != "" {
			userID, err := uuid.Parse(userIDStr)
			if err == nil {
				c.Locals("userID", userID)
			}
		}
		return c.Next()
	})

	app.Get("/mentions", func(c *fiber.Ctx) error {
		userID, err := getUserIDFromContext(c)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{
				"error": "unauthorized",
			})
		}

		filter := &models.MentionFilter{
			UserID: userID,
		}

		if unread := c.Query("unread"); unread != "" {
			isUnread := unread == "true" || unread == "1"
			filter.Unread = &isUnread
		}

		if mentionType := c.Query("type"); mentionType != "" {
			mt := models.MentionKind(mentionType)
			filter.MentionType = &mt
		}

		if channelID := c.Query("channel_id"); channelID != "" {
			id, err := uuid.Parse(channelID)
			if err == nil {
				filter.ChannelID = &id
			}
		}

		if guildID := c.Query("guild_id"); guildID != "" {
			id, err := uuid.Parse(guildID)
			if err == nil {
				filter.GuildID = &id
			}
		}

		filter.Limit = c.QueryInt("limit", 50)
		filter.Offset = c.QueryInt("offset", 0)

		if before := c.Query("before"); before != "" {
			if t, err := time.Parse(time.RFC3339, before); err == nil {
				filter.Before = &t
			}
		}

		if after := c.Query("after"); after != "" {
			if t, err := time.Parse(time.RFC3339, after); err == nil {
				filter.After = &t
			}
		}

		mentions, total, err := mock.getMentionsFunc(c.Context(), filter)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "failed to get mentions",
			})
		}

		hasMore := len(mentions) > filter.Limit
		if hasMore {
			mentions = mentions[:filter.Limit]
		}

		return c.JSON(models.MentionsListResponse{
			Mentions:   mentions,
			TotalCount: total,
			HasMore:    hasMore,
		})
	})

	app.Get("/mentions/unread/count", func(c *fiber.Ctx) error {
		userID, err := getUserIDFromContext(c)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{
				"error": "unauthorized",
			})
		}

		count, err := mock.getUnreadCountFunc(c.Context(), userID)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "failed to get unread count",
			})
		}

		return c.JSON(fiber.Map{
			"count": count,
		})
	})

	app.Get("/mentions/stats", func(c *fiber.Ctx) error {
		userID, err := getUserIDFromContext(c)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{
				"error": "unauthorized",
			})
		}

		stats, err := mock.getStatsFunc(c.Context(), userID)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "failed to get mention stats",
			})
		}

		return c.JSON(stats)
	})

	app.Get("/mentions/search", func(c *fiber.Ctx) error {
		userID, err := getUserIDFromContext(c)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{
				"error": "unauthorized",
			})
		}

		query := c.Query("q")
		if query == "" {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "search query is required",
			})
		}

		limit := c.QueryInt("limit", 20)

		mentions, err := mock.searchFunc(c.Context(), userID, query, limit)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "failed to search mentions",
			})
		}

		return c.JSON(fiber.Map{
			"mentions": mentions,
			"count":    len(mentions),
		})
	})

	app.Patch("/mentions/:id/read", func(c *fiber.Ctx) error {
		userID, err := getUserIDFromContext(c)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{
				"error": "unauthorized",
			})
		}

		mentionID, err := uuid.Parse(c.Params("id"))
		if err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "invalid mention ID",
			})
		}

		if err := mock.markAsReadFunc(c.Context(), mentionID, userID); err != nil {
			if err == services.ErrMentionNotFound {
				return c.Status(fiber.StatusNotFound).JSON(fiber.Map{
					"error": "mention not found",
				})
			}
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "failed to mark mention as read",
			})
		}

		return c.JSON(fiber.Map{
			"success": true,
		})
	})

	app.Post("/mentions/read-all", func(c *fiber.Ctx) error {
		userID, err := getUserIDFromContext(c)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{
				"error": "unauthorized",
			})
		}

		count, err := mock.markAllAsReadFunc(c.Context(), userID)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "failed to mark mentions as read",
			})
		}

		return c.JSON(fiber.Map{
			"success": true,
			"count":   count,
		})
	})

	app.Post("/mentions/channel/:channelId/read-all", func(c *fiber.Ctx) error {
		userID, err := getUserIDFromContext(c)
		if err != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{
				"error": "unauthorized",
			})
		}

		channelID, err := uuid.Parse(c.Params("channelId"))
		if err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "invalid channel ID",
			})
		}

		count, err := mock.markChannelMentionsAsReadFunc(c.Context(), userID, channelID)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "failed to mark mentions as read",
			})
		}

		return c.JSON(fiber.Map{
			"success": true,
			"count":   count,
		})
	})

	return app
}

func TestGetMentions_Success(t *testing.T) {
	mentionID := uuid.New()
	userID := uuid.New()

	mock := &mockMentionService{
		getMentionsFunc: func(ctx context.Context, filter *models.MentionFilter) ([]*models.Mention, int, error) {
			return []*models.Mention{
				{
					ID:          mentionID,
					UserID:      userID,
					ChannelID:   uuid.New(),
					MessageID:   uuid.New(),
					MentionType: models.MentionKindUser,
					CreatedAt:   time.Now(),
				},
			}, 1, nil
		},
	}

	app := setupMentionsTestApp(mock)
	t.Cleanup(func() { _ = app.Shutdown() })

	req := httptest.NewRequest("GET", "/mentions", nil)
	req.Header.Set("X-Test-User-ID", userID.String())

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, 200, resp.StatusCode)

	var result models.MentionsListResponse
	err = json.NewDecoder(resp.Body).Decode(&result)
	assert.NoError(t, err)
	assert.Equal(t, 1, result.TotalCount)
	assert.Len(t, result.Mentions, 1)
	assert.Equal(t, mentionID, result.Mentions[0].ID)
}

func TestGetMentions_WithFilters(t *testing.T) {
	userID := uuid.New()
	channelID := uuid.New()
	guildID := uuid.New()

	mock := &mockMentionService{
		getMentionsFunc: func(ctx context.Context, filter *models.MentionFilter) ([]*models.Mention, int, error) {
			assert.NotNil(t, filter.Unread)
			assert.True(t, *filter.Unread)
			assert.NotNil(t, filter.MentionType)
			assert.Equal(t, models.MentionKindUser, *filter.MentionType)
			assert.NotNil(t, filter.ChannelID)
			assert.Equal(t, channelID, *filter.ChannelID)
			assert.NotNil(t, filter.GuildID)
			assert.Equal(t, guildID, *filter.GuildID)
			return []*models.Mention{}, 0, nil
		},
	}

	app := setupMentionsTestApp(mock)
	t.Cleanup(func() { _ = app.Shutdown() })

	req := httptest.NewRequest("GET", "/mentions?unread=true&type=user&channel_id="+channelID.String()+"&guild_id="+guildID.String()+"&limit=10&offset=5", nil)
	req.Header.Set("X-Test-User-ID", userID.String())

	resp, err := app.Test(req, -1)
	assert.NoError(t, err)
	assert.Equal(t, 200, resp.StatusCode)
}

