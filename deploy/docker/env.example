# Hearth Backend Environment Variables
# Copy to backend.env and fill in values

# ============ REQUIRED ============

# Database
DB_PASSWORD=change_me_generate_strong_password

# Redis
REDIS_PASSWORD=change_me_generate_strong_password

# JWT Secret (generate: openssl rand -base64 64)
JWT_SECRET=change_me_generate_strong_jwt_secret

# ============ URLs ============

# Your domain
DOMAIN=hearth.example.com

# API URLs for frontend
API_URL=https://hearth.example.com/api
WS_URL=wss://hearth.example.com/ws

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://hearth.example.com,https://app.hearth.example.com

# ============ OPTIONAL ============

LOG_LEVEL=info

# S3-compatible storage (optional)
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=hearth-attachments
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Email (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@hearth.example.com
