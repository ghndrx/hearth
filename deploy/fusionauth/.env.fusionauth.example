# FusionAuth Configuration for Hearth
# Copy this file to .env and configure before running

# ============================================
# FusionAuth Server
# ============================================

# Port for FusionAuth admin UI (default: 9011)
FUSIONAUTH_PORT=9011

# Runtime mode: development or production
# Development mode disables some security checks for easier setup
FUSIONAUTH_RUNTIME_MODE=development

# Memory allocation for FusionAuth
FUSIONAUTH_APP_MEMORY=512M

# ============================================
# FusionAuth Database (PostgreSQL)
# ============================================

FUSIONAUTH_DB_USER=fusionauth
FUSIONAUTH_DB_PASSWORD=change-me-to-a-secure-password
FUSIONAUTH_DB_NAME=fusionauth

# ============================================
# Search (optional)
# ============================================

# Set to "elasticsearch" and enable the "search" profile for advanced search
# Set to "database" (default) for simple search without Elasticsearch
FUSIONAUTH_SEARCH_TYPE=database

# Only used when FUSIONAUTH_SEARCH_TYPE=elasticsearch
# FUSIONAUTH_SEARCH_SERVERS=http://fusionauth-es:9200
# FUSIONAUTH_ES_JAVA_OPTS=-Xms256m -Xmx256m

# ============================================
# Hearth Integration
# ============================================
# After setting up FusionAuth, configure these in your main Hearth .env

# The URL where Hearth can reach FusionAuth (internal Docker network)
FUSIONAUTH_HOST=http://hearth-fusionauth:9011

# Create an Application in FusionAuth admin UI, then fill these in:
FUSIONAUTH_APPLICATION_ID=your-application-id
FUSIONAUTH_CLIENT_ID=your-client-id
FUSIONAUTH_CLIENT_SECRET=your-client-secret

# Create an API key in FusionAuth admin UI (Settings > API Keys)
FUSIONAUTH_API_KEY=your-api-key
