# Hearth Development Environment
# Copy to .env and configure values

# Required
SECRET_KEY=change-me-to-random-32-bytes

# Public URL (for links, embeds, OAuth callbacks)
PUBLIC_URL=http://localhost:3000

# Ports
HTTP_PORT=8080

# Logging
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://hearth:hearth_dev_password@localhost:5432/hearth?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./data/uploads

# Registration
REGISTRATION_ENABLED=true
INVITE_ONLY=false

# OAuth (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# LiveKit (Voice/Video) — optional for local dev
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=

# Stripe Billing (optional — leave blank for mock mode)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BASIC=price_...
# STRIPE_PRICE_PREMIUM=price_...

# Matrix Federation — optional
# FEDERATION_ENABLED=false
